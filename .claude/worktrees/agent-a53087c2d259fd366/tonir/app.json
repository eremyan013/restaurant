{
  "expo": {
    "name": "Tonir",
    "slug": "tonir",
    "scheme": "tonir",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.tonir.app",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "com.tonir.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "tonir" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      ["expo-notifications", { "color": "#1A1208" }],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow Tonir to add your reservation to your calendar."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c56d5076-3d92-45f0-ae79-fe3c3f4f34cc"
      }
    },
    "owner": "yeremyan"
  }
}
